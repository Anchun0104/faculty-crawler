QWidget {
    color: @TEXT_PRIMARY@;
    font-family: "Segoe UI Variable", "Microsoft YaHei UI", "Segoe UI";
    font-size: 14px;
}

QMainWindow, #appShell { background: @APP_BACKGROUND@; }
#primaryNavigation {
    background: @NAV_BACKGROUND@;
    border-right: 1px solid @BORDER_DEFAULT@;
}
#contentSurface { background: @APP_BACKGROUND@; }
#shellTitle {
    background: @SURFACE_SECONDARY@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_SUBTLE@;
    border-radius: 8px;
    padding: 0 16px;
    min-height: 32px;
}
#navigationProductName { color: @TEXT_PRIMARY@; font-size: 15px; font-weight: 600; }
#navigationGroup {
    color: @TEXT_SECONDARY@;
    font-size: 11px;
    font-weight: 600;
    padding: 12px 8px 4px;
}
#pageHeading { color: @TEXT_PRIMARY@; font-size: 28px; font-weight: 650; }
#sectionHeading { color: @TEXT_PRIMARY@; font-size: 18px; font-weight: 600; }

QToolButton#navigation_overview,
QToolButton#navigation_tasks,
QToolButton#navigation_verification,
QToolButton#navigation_runs,
QToolButton#navigation_sessions,
QToolButton#navigation_settings {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: @TEXT_SECONDARY@;
    min-height: 34px;
    padding: 0 10px;
    text-align: left;
}
QToolButton#navigation_overview:hover,
QToolButton#navigation_tasks:hover,
QToolButton#navigation_verification:hover,
QToolButton#navigation_runs:hover,
QToolButton#navigation_sessions:hover,
QToolButton#navigation_settings:hover { background: @SURFACE_HOVER@; color: @TEXT_PRIMARY@; }
QToolButton#navigation_overview:checked,
QToolButton#navigation_tasks:checked,
QToolButton#navigation_verification:checked,
QToolButton#navigation_runs:checked,
QToolButton#navigation_sessions:checked,
QToolButton#navigation_settings:checked {
    background: @PRIMARY_SOFT@;
    border-color: #C8DFF2;
    color: @TEXT_PRIMARY@;
    font-weight: 600;
}

QFrame#infoBar {
    background: @INFO_SOFT@;
    border: 1px solid #D6E8F7;
    border-radius: 8px;
    color: #244E73;
}
QFrame#metricCard,
QFrame#settingsGroup,
QFrame#taskInspector,
QFrame#verificationInspector,
QFrame#choiceCard,
QFrame#currentRunCard,
QFrame#quickStartCard,
QFrame#runBatchList,
QFrame#runDetailPanel,
QFrame#storageUsageCard,
QFrame#storageRetentionCard,
QFrame#mockBrowserCard {
    background: @SURFACE_PRIMARY@;
    border: 1px solid @BORDER_DEFAULT@;
    border-radius: 12px;
}

QPushButton {
    background: @SURFACE_PRIMARY@;
    border: 1px solid @BORDER_DEFAULT@;
    border-radius: 8px;
    color: @TEXT_PRIMARY@;
    min-height: 34px;
    padding: 0 14px;
}
QPushButton:hover { background: @SURFACE_HOVER@; border-color: #B9C8D6; }
QPushButton:pressed { background: #E7EEF5; }
QPushButton:disabled { color: @TEXT_TERTIARY@; background: #F7F9FB; border-color: @BORDER_SUBTLE@; }
QPushButton#primaryButton { background: @PRIMARY@; border: 1px solid @PRIMARY@; color: white; font-weight: 600; }
QPushButton#primaryButton:hover { background: @PRIMARY_HOVER@; border-color: @PRIMARY_HOVER@; }
QPushButton#primaryButton:pressed { background: @PRIMARY_PRESSED@; border-color: @PRIMARY_PRESSED@; }
QPushButton#primaryButton:disabled {
    color: @TEXT_TERTIARY@;
    background: #F7F9FB;
    border-color: @BORDER_SUBTLE@;
}
QPushButton#dangerButton { background: @SURFACE_PRIMARY@; border-color: #E6A8A9; color: @DANGER@; }
QPushButton#dangerButton:hover { background: @DANGER_SOFT@; }
QPushButton#dangerButton:disabled { color: @TEXT_TERTIARY@; background: #F7F9FB; border-color: @BORDER_SUBTLE@; }

QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QDoubleSpinBox {
    background: @SURFACE_PRIMARY@;
    border: 1px solid @BORDER_DEFAULT@;
    border-radius: 8px;
    color: @TEXT_PRIMARY@;
    min-height: 34px;
    padding: 0 10px;
}
QPlainTextEdit, QTextEdit { padding: 8px 10px; }
QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled, QComboBox:disabled, QDoubleSpinBox:disabled {
    background: @SURFACE_SECONDARY@;
    color: @TEXT_TERTIARY@;
}
QComboBox::drop-down { width: 28px; border: 0; }
QComboBox QAbstractItemView { background: @SURFACE_PRIMARY@; border: 1px solid @BORDER_DEFAULT@; selection-background-color: @PRIMARY_SOFT@; }
QCheckBox { spacing: 8px; min-height: 28px; }

QPushButton:focus, QToolButton:focus, QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QCheckBox:focus {
    border: 2px solid @PRIMARY@;
}

QTableWidget {
    background: @SURFACE_PRIMARY@;
    border: 1px solid @BORDER_DEFAULT@;
    border-radius: 12px;
    gridline-color: transparent;
    selection-background-color: @PRIMARY_SOFT@;
    selection-color: @TEXT_PRIMARY@;
}
QTableWidget::item { border-bottom: 1px solid @BORDER_SUBTLE@; padding: 0 10px; }
QTableWidget::item:selected { background: @PRIMARY_SOFT@; color: @TEXT_PRIMARY@; }
QHeaderView::section {
    background: @SURFACE_SECONDARY@;
    border: 0;
    border-bottom: 1px solid @BORDER_DEFAULT@;
    color: @TEXT_SECONDARY@;
    font-size: 13px;
    font-weight: 600;
    padding: 0 10px;
}
QScrollBar:vertical { background: transparent; width: 10px; margin: 4px 0; }
QScrollBar::handle:vertical { background: #C5D0DB; border-radius: 5px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #AAB9C7; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0 4px; }
QScrollBar::handle:horizontal { background: #C5D0DB; border-radius: 5px; min-width: 24px; }

#emptyStateTitle { color: @TEXT_PRIMARY@; font-size: 18px; font-weight: 600; }
#emptyStateIcon { color: @PRIMARY@; font-size: 32px; min-height: 32px; }
#pageDescription { color: @TEXT_SECONDARY@; font-size: 13px; }
#settingsRow { background: @SURFACE_PRIMARY@; border-bottom: 1px solid @BORDER_SUBTLE@; }
#emptyStateDetail, #settingRowHint, #metricNote, #duplicateUrlDetails { color: @TEXT_SECONDARY@; }
#metricValue { color: @TEXT_PRIMARY@; font-size: 24px; font-weight: 650; }
#keyStatus, #connectionStatus { color: @TEXT_SECONDARY@; font-weight: 600; }
#statusBadge { color: @TEXT_SECONDARY@; }
#timelineEvent { border-bottom: 1px solid @BORDER_SUBTLE@; }
#timelineDot { color: @PRIMARY@; font-size: 11px; }
#timelineTime { color: @TEXT_SECONDARY@; font-size: 12px; }
#mockBrowserCard { background: @SURFACE_SECONDARY@; }
#browserAddress { background: #E8EDF3; border-bottom: 1px solid @BORDER_DEFAULT@; color: @TEXT_SECONDARY@; padding: 4px 6px; }
#browserBody { background: @SURFACE_SECONDARY@; color: @TEXT_SECONDARY@; padding: 8px; }
#settingsNavButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: @TEXT_SECONDARY@;
    min-height: 34px;
    padding: 0 10px;
    text-align: left;
}
#settingsNavButton:hover { background: @SURFACE_HOVER@; color: @TEXT_PRIMARY@; }
#settingsNavButton:checked { background: @PRIMARY_SOFT@; border-color: #C8DFF2; color: @PRIMARY@; font-weight: 600; }
#storageUsageBar { min-height: 10px; max-height: 10px; border: 0; border-radius: 5px; background: #E9EDF2; }
#storageUsageBar::chunk { background: @PRIMARY@; border-radius: 5px; }
QToolButton#urlModeCard,
QToolButton#xlsxModeCard {
    background: @SURFACE_PRIMARY@;
    border: 1px solid @BORDER_DEFAULT@;
    border-radius: 10px;
    color: @TEXT_PRIMARY@;
    min-height: 56px;
    padding: 0 16px;
    text-align: left;
}
QToolButton#urlModeCard:hover,
QToolButton#xlsxModeCard:hover { background: @SURFACE_HOVER@; }
QToolButton#urlModeCard:checked,
QToolButton#xlsxModeCard:checked { background: @PRIMARY_SOFT@; border: 2px solid @PRIMARY@; color: @TEXT_PRIMARY@; font-weight: 600; }
#dialogTitle { color: @TEXT_PRIMARY@; font-size: 22px; font-weight: 650; }
#sourceSummary { color: @TEXT_PRIMARY@; font-weight: 600; }
#sourceValidation { color: @DANGER@; }
#batchConfirmation { color: @TEXT_SECONDARY@; }
#fieldLabel { color: @TEXT_SECONDARY@; font-size: 12px; font-weight: 600; }
